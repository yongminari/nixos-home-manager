+    pub fn cycle_column_alignment(&mut self) {
+        let Some(col) = self.columns.get(self.active_column_idx) else {
+            return;
+        };
+
+        // Fullscreen and maximized columns have no free space to align within.
+        if !col.sizing_mode().is_normal() {
+            return;
+        }
+
+        let area = self.working_area;
+        let gap = self.options.layout.gaps;
+        let width = col.width();
+        let pixel = 1. / self.scale;
+        if area.size.w - width - 2. * gap <= 2. * pixel {
+            return;
+        }
+
+        let center = -(area.size.w - width) / 2. - area.loc.x;
+        let left = -area.loc.x - gap;
+        let right = -area.loc.x - area.size.w + gap + width;
+
+        // Use the animation target so rapid key presses still advance the cycle.
+        // An arbitrary position starts at center; no external state is needed.
+        let current = self.view_offset.target();
+        let next = if (current - center).abs() < pixel {
+            left
+        } else if (current - left).abs() < pixel {
+            right
+        } else {
+            center
+        };
+        self.animate_view_offset(self.active_column_idx, next);
+
+        let col = &mut self.columns[self.active_column_idx];
+        cancel_resize_for_column(&mut self.interactive_resize, col);
