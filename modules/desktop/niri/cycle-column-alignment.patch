+use super::*;
+
+fn setup(scale: f64, count: usize) -> Layout<TestWindow> {
+    let options = Options {
+        layout: niri_config::Layout {
+            gaps: 20.,
+            center_focused_column: CenterFocusedColumn::Always,
+            always_center_single_column: true,
+            struts: Struts {
+                left: FloatOrInt(40.),
+                right: FloatOrInt(60.),
+                ..Default::default()
+            },
+            ..Default::default()
+        },
+        ..Default::default()
+    };
+    let mut layout = check_ops_with_options(
+        options,
+        [Op::AddScaledOutput {
+            id: 1,
+            scale,
+            layout_config: None,
+        }],
+    );
+    for id in 1..=count {
+        check_ops_on_layout(
+            &mut layout,
+            [
+                Op::AddWindow {
+                    params: TestWindowParams::new(id),
+                },
+                Op::Communicate(id),
+            ],
+        );
+    }
+    check_ops_on_layout(&mut layout, [Op::CenterColumn, Op::CompleteAnimations]);
+    layout
+}
+
+#[test]
+fn alignment_cycle_preserves_tiling_and_handles_rapid_presses() {
+    for scale in [1., 1.25, 2.] {
+        for count in [1, 3] {
+            let mut layout = setup(scale, count);
+            let scrolling = layout.active_workspace().unwrap().scrolling();
+            let width = scrolling.tiles().last().unwrap().animated_tile_size().w;
+            let center = scrolling.view_offset().target();
+            let right = -(1280. / scale - 60.) + 20. + width;
+            // Do not finish animations between presses: the target must advance.
+            for expected in [-60., right, center, -60., right, center] {
+                layout.cycle_column_alignment();
+                let scrolling = layout.active_workspace().unwrap().scrolling();
+                assert!((scrolling.view_offset().target() - expected).abs() < 0.001);
+                assert_eq!(scrolling.columns().count(), count);
+                assert_eq!(scrolling.tiles().count(), count);
+                assert_eq!(layout.focus().unwrap().id(), &count);
+                layout.verify_invariants();
+            }
+            check_ops_on_layout(&mut layout, [Op::CompleteAnimations]);
+            let scrolling = layout.active_workspace().unwrap().scrolling();
+            assert!((scrolling.view_offset().current() - center).abs() < 0.001);
+        }
+    }
+}
+
+#[test]
+fn alignment_cycle_keeps_empty_floating_and_fullscreen_unchanged() {
+    let mut layout = setup(1., 0);
+    layout.cycle_column_alignment();
+    layout.verify_invariants();
+
+    let mut layout = setup(1., 1);
+    check_ops_on_layout(
+        &mut layout,
+        [
+            Op::FullscreenWindow(1),
+            Op::Communicate(1),
+            Op::CompleteAnimations,
+        ],
+    );
+    let before = layout
+        .active_workspace()
+        .unwrap()
+        .scrolling()
+        .view_offset()
+        .target();
+    layout.cycle_column_alignment();
+    assert_eq!(
+        layout
+            .active_workspace()
+            .unwrap()
+            .scrolling()
+            .view_offset()
+            .target(),
+        before
+    );
+    layout.verify_invariants();
+
+    let mut layout = setup(1., 1);
+    check_ops_on_layout(
+        &mut layout,
+        [
+            Op::ToggleWindowFloating { id: None },
+            Op::Communicate(1),
+            Op::CompleteAnimations,
+        ],
+    );
+    let before = layout
+        .active_workspace()
+        .unwrap()
+        .tiles_with_render_positions()
+        .map(|(_, pos, _)| pos)
+        .collect::<Vec<_>>();
+    layout.cycle_column_alignment();
+    let after = layout
+        .active_workspace()
+        .unwrap()
+        .tiles_with_render_positions()
+        .map(|(_, pos, _)| pos)
+        .collect::<Vec<_>>();
+    assert_eq!(after, before);
+    layout.verify_invariants();
+}
