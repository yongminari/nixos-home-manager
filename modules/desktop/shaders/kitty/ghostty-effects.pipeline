textures a persist

# Keep the background moving while focused, as in the Ghostty configuration.
startgroup
    animation_start os-window-focus-in | user-activity
    animation_stop os-window-focus-out
    animation_step 16
    shaders hexglitch-background
endgroup

# Subscribing to cursor-trail-move replaces Kitty's built-in trail rendering.
# Cursor geometry is unavailable after cursor-trail-stop; never retain stale positions.
startgroup
    animation_start cursor-trail-move
    animation_stop cursor-trail-stop | os-window-focus-out
    animation_step 16
    shaders ripple-cursor cursor-tail
endgroup

# Independent paint lifetime. Cache cursor geometry, never a rendered frame.
# Repeat the events so every pass restarts its
# timer on each move (attached groups in Kitty 0.49 do not resync on restart).

startgroup
    animation_start cursor-trail-move
    animation_stop 2000 | os-window-focus-out | window-focus-out | tab-change
    animation_step 16
    output_texture a
    shaders splatter-state
endgroup

startgroup
    animation_start cursor-trail-move
    animation_stop 2000 | os-window-focus-out | window-focus-out | tab-change
    animation_step 16
    output_texture persist
    shaders splatter-store
endgroup

startgroup
    animation_start cursor-trail-move
    animation_stop 2000 | os-window-focus-out | window-focus-out | tab-change
    animation_step 16
    shaders cursor-splatter
endgroup

# Shift the fully composited frame; never feed shifted pixels into splatter state.
startgroup
    animation_start cursor-trail-move
    animation_stop 180 | cursor-trail-stop | os-window-focus-out | window-focus-out | tab-change
    animation_step 16
    shaders screen-shake
endgroup
